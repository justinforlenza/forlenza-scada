<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Bundle Name="Forlenza SCADA Control System"
          Version="2.1.0.0"
          Manufacturer="Forlenza Industrial Systems"
          UpgradeCode="87654321-4321-8765-9012-098765432109"
          IconSourceFile="src\icon.ico">

    <!-- Display bootstrap application UI -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication 
        LicenseUrl=""
        Theme="hyperlinkLicense"
        ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- Registry search to detect if Visual C++ Redistributable is already installed -->
    <!-- VC++ 2015-2022 all use the same registry key location -->
    <util:RegistrySearch
      Id="SearchVCRedist2015x64"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
      Value="Installed"
      Result="exists"
      Variable="VCRedist2015x64Installed" />

    <util:RegistrySearch
      Id="SearchVCRedist2017x64"
      Root="HKLM"
      Key="SOFTWARE\Wow6432Node\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
      Value="Installed"
      Result="exists"
      Variable="VCRedist2017x64Installed" />

    <!-- Chain of packages to install -->
    <Chain>
      <!-- Visual C++ 2015-2022 Redistributable (x64) -->
      <!-- The 2015-2022 redistributables are all compatible and share registry keys -->
      <ExePackage
        Id="VCRedist_x64"
        SourceFile="web\VC_redist.x64.exe"
        DownloadUrl="https://aka.ms/vs/17/release/vc_redist.x64.exe"
        InstallCommand="/install /quiet /norestart"
        RepairCommand="/repair /quiet /norestart"
        UninstallCommand="/uninstall /quiet /norestart"
        PerMachine="yes"
        Permanent="yes"
        DetectCondition="VCRedist2015x64Installed OR VCRedist2017x64Installed"
        InstallCondition="VersionNT64"
        Vital="yes"
        Compressed="yes">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="forceReboot" />
      </ExePackage>

      <!-- Main MSI Package -->
      <MsiPackage
        Id="MainMSI"
        SourceFile="installer.msi"
        Vital="yes"
        Compressed="yes">
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
